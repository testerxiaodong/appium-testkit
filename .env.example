# Reference only: testkit does NOT automatically load .env files.
# Export needed values in your shell or inject them through CI.
# APPIUM_PLATFORM=android
# APPIUM_ANDROID_UDID=your-android-device-id
# APPIUM_IOS_UDID=your-ios-device-id
# APPIUM_ANDROID_APP=/absolute/path/to/app.apk
# APPIUM_IOS_APP=/absolute/path/to/Runner.app
# APPIUM_COMMAND_TIMEOUT=120
# APPIUM_XCODE_TEAM_ID=your-development-team
# APPIUM_SERVER_URL is a fallback when server_url is absent in YAML.
# Parallel managed devices need separate server URLs; prefer YAML.
